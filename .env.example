# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Database → Connection string → "Transaction" pooler (port 6543).
# Use port 6543 (transaction), NOT 5432 (session) — session mode caps at ~15
# clients and Next.js will exhaust it. Prefer the pooler host for IPv4 networks.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

