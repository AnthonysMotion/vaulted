# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Database → Connection string → "Transaction" pooler (port 6543).
# Use port 6543 (transaction), NOT 5432 (session). Session mode caps at ~15
# clients and Next.js will exhaust it. Prefer the pooler host for IPv4 networks.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Optional. drizzle-kit push/generate need a session or direct connection
# (port 5432). If unset, drizzle.config.ts rewrites DATABASE_URL :6543 → :5432.
# DATABASE_URL_MIGRATE=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# OAuth (enable in Supabase → Authentication → Providers):
# 1. Google: create OAuth client in Google Cloud Console; add redirect URI
#    https://YOUR-PROJECT.supabase.co/auth/v1/callback
# 2. Discord: create app at discord.com/developers; same Supabase callback URI
# 3. In Supabase → Authentication → URL Configuration, add your site URL and
#    redirect allow list entry: http://localhost:3000/auth/callback
#    (and your production https://…/auth/callback)

# Optional. Pokémon TCG API key from https://dev.pokemontcg.io
# Used for on-demand TCGplayer prices (refreshed when a card is opened if
# the cache is older than a day) and by `npm run db:prices` for bulk backfill.
# POKEMONTCG_API_KEY=your-api-key

